# functions/.env.local 로 복사해서 채운다 (git 에 커밋되지 않음).
# 에뮬레이터에서 Cloud Functions 를 돌릴 때 사용된다.

# Upstage(Solar) API 키 — https://console.upstage.ai
UPSTAGE_API_KEY=

# (선택) 사용할 모델. 기본값 solar-pro4
UPSTAGE_MODEL=solar-pro4

# (선택) App Check 강제 여부. 로컬에서는 비워둔다.
ENFORCE_APP_CHECK=false

# (선택) 허용할 프런트 origin (콤마 구분). 비우면 localhost + 배포 도메인 기본값.
APP_ORIGINS=
