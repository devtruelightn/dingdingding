# Firebase 웹 앱 설정 (콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI 문장 생성(Cloud Functions) 사용 여부
NEXT_PUBLIC_ENABLE_CLOUD_AI=true

# 로컬 개발: Firebase 에뮬레이터(Auth 9099 / Firestore 8080 / Functions 5001)에 연결
# `npm run dev:local` 로 실행할 때만 true 로 둔다. 배포 빌드에서는 반드시 비운다.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# App Check (선택). reCAPTCHA Enterprise 사이트 키가 있을 때만 채운다.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
